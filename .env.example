# Copy to .env (never commit .env).
# Optional: EIA API v2 key. Without it, the public EIA-930 six-month bulk CSVs are used (same data).
EIA_API_KEY=
# Optional: Census API key. Without it, tract population is read from the PL 94-171 geographic header.
CENSUS_API_KEY=
# Optional: enables the LLM agent team (deepagents + Google Gemini via LangChain). Without it, the rule-based planner runs.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override for the agents and report parser (https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=gemini-3.5-flash
# Which planner runs. Default "agents": the deep-agents team (orchestrator, specialists, shared files) driven by rules,
# with real agent calls and no AI model. "gemini": the same team with Gemini deciding each step (needs the key above;
# falls back to "agents"). "rules": the plain rule-based planner, no agent graph.
# AGENT_PLANNER=agents
# Optional: the LED strip (hardware/lights/README.md). The ESP32's serial port is found by itself; name it here if it
# is not, or set "off" to never open one.
# LIGHTS_PORT=/dev/cu.usbserial-10
# Optional: text alerts through Twilio (backend/notify.py). Without all of the first three, alerts run as a dry run:
# the message is logged and shown on screen as "would have sent", and no text is sent. ALERT_PHONE is who gets them.
# Alerts are off unless ALERTS_ON=1 (or the bell's switch is turned on while the server runs).
# ALERTS_ON=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE=
# Optional: the CoStar track (HackPrinceton). Vexcel imagery uses VEXCEL_API_KEY; the zip password opens the CoStar kit.
# The app uses two of the track's layers, the CoStar data kit and Vexcel. It does not use Matterport.
VEXCEL_API_KEY=
COSTAR_KIT_ZIP_PASSWORD=
